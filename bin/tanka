#!/usr/bin/env bash
# Tanka launcher: arranca Claude Code (Haiku por defecto) en un workspace limpio
# con SOLO el plugin Tanka, SOLO los MCP de .tanka/mcp.json y sin settings de usuario.
set -euo pipefail

TANKA_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_DIR="${TANKA_PLUGIN_DIR:-$TANKA_REPO/plugin}"
TEMPLATE_DIR="$TANKA_REPO/workspace-template"
DEFAULT_WS="${TANKA_HOME:-$HOME/tanka-workspace}"
MODEL="${TANKA_MODEL:-haiku}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

usage() {
  cat <<USAGE
tanka — harness de asistente seguro sobre Claude Haiku

Uso:
  tanka init [dir]                 Crea un workspace limpio (por defecto: $DEFAULT_WS)
  tanka start [dir] [-- args...]   Sesión interactiva aislada en el workspace
  tanka run "tarea" [dir] [--objective nombre] [--max-turns N] [--budget USD]
                                   Tarea delegada sin interacción (fail-closed: los envíos se deniegan)
  tanka doctor [dir]               Comprueba configuración, plugin y estado
  tanka test                       Ejecuta los tests del harness

Variables: TANKA_HOME (workspace por defecto), TANKA_MODEL (haiku), TANKA_PLUGIN_DIR, CLAUDE_BIN
USAGE
}

resolve_ws() {
  local d="${1:-$DEFAULT_WS}"
  [[ "$d" == "--" ]] && d="$DEFAULT_WS"
  echo "$d"
}

require_ws() {
  local ws="$1"
  if [[ ! -f "$ws/.tanka/policy.json" ]]; then
    echo "✗ '$ws' no es un workspace Tanka (falta .tanka/policy.json). Ejecuta: tanka init $ws" >&2
    exit 1
  fi
}

cmd_init() {
  local ws; ws="$(resolve_ws "${1:-}")"
  if [[ -e "$ws/.tanka/policy.json" ]]; then
    echo "✗ Ya existe un workspace en $ws (no se sobreescribe)." >&2; exit 1
  fi
  mkdir -p "$ws"
  cp -R "$TEMPLATE_DIR/." "$ws/"
  mkdir -p "$ws/.tanka/state" "$ws/.tanka/drafts" "$ws/.claude/skills"
  echo "✓ Workspace creado en $ws"
  echo "  1. Edita $ws/.tanka/mcp.json y añade SOLO los servidores MCP que necesites (ver mcp.example.json)."
  echo "  2. Copia tus skills de asistencia (no de código) a $ws/.claude/skills/<nombre>/SKILL.md"
  echo "  3. Arranca: tanka start $ws   y ejecuta /tanka:setup para definir nombre y personalidad."
}

common_args() {
  local ws="$1"
  # Aislamiento: sin settings de usuario, sin MCP ajenos, sin plugins ajenos.
  printf '%s\n' \
    --setting-sources project,local \
    --strict-mcp-config --mcp-config "$ws/.tanka/mcp.json" \
    --plugin-dir "$PLUGIN_DIR" \
    --model "$MODEL" \
    --disallowedTools Bash PowerShell NotebookEdit
}

cmd_start() {
  local ws; ws="$(resolve_ws "${1:-}")"; shift || true
  [[ "${1:-}" == "$ws" ]] && shift || true
  [[ "${1:-}" == "--" ]] && shift || true
  require_ws "$ws"
  cd "$ws"
  mapfile -t ARGS < <(common_args "$ws")
  exec "$CLAUDE_BIN" "${ARGS[@]}" --permission-mode default "$@"
}

cmd_run() {
  local task="${1:-}"; shift || true
  [[ -z "$task" ]] && { echo "✗ Falta la tarea." >&2; usage; exit 1; }
  local ws="$DEFAULT_WS" objective="" max_turns="${TANKA_MAX_TURNS:-20}" budget="${TANKA_BUDGET_USD:-1.00}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --objective) objective="$2"; shift 2;;
      --max-turns) max_turns="$2"; shift 2;;
      --budget) budget="$2"; shift 2;;
      --) shift; break;;
      *) ws="$1"; shift;;
    esac
  done
  require_ws "$ws"
  cd "$ws"
  if [[ -n "$objective" ]]; then
    local src="$ws/.tanka/objectives/$objective.json"
    [[ -f "$src" ]] || { echo "✗ No existe $src" >&2; exit 1; }
    mkdir -p "$ws/.tanka/state"
    python3 - "$src" "$ws/.tanka/state/objective.json" <<'PY'
import json, sys, time
src, dst = sys.argv[1], sys.argv[2]
obj = json.load(open(src, encoding="utf-8"))
obj["status"] = "active"
obj["created_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
obj["may_send"] = False  # modo delegado: nunca enviar sin humano
json.dump(obj, open(dst, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print(f"✓ Objetivo '{obj.get('title')}' activado (may_send forzado a false en modo delegado)")
PY
  fi
  mapfile -t ARGS < <(common_args "$ws")
  # Fail-closed: cualquier tool que pediría confirmación se deniega automáticamente.
  "$CLAUDE_BIN" "${ARGS[@]}" -p "$task" \
    --permission-mode default --permission-prompts none \
    --max-turns "$max_turns" --max-budget-usd "$budget" \
    --output-format text "$@"
}

cmd_doctor() {
  local ws; ws="$(resolve_ws "${1:-}")"
  echo "Repo:     $TANKA_REPO"
  echo "Plugin:   $PLUGIN_DIR"
  echo "Workspace: $ws"
  command -v "$CLAUDE_BIN" >/dev/null || { echo "✗ No encuentro '$CLAUDE_BIN' en PATH"; exit 1; }
  echo "Claude:   $("$CLAUDE_BIN" --version 2>/dev/null | head -1)"
  command -v python3 >/dev/null || { echo "✗ python3 es necesario para los hooks"; exit 1; }
  echo "Python:   $(python3 --version)"
  echo "--- plugin validate"
  "$CLAUDE_BIN" plugin validate "$PLUGIN_DIR" || true
  if [[ -f "$ws/.tanka/policy.json" ]]; then
    echo "--- workspace"
    for f in policy.json persona.json mcp.json; do
      if python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$ws/.tanka/$f" 2>/dev/null; then echo "✓ .tanka/$f"; else echo "✗ .tanka/$f inválido"; fi
    done
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$ws/.claude/settings.json" && echo "✓ .claude/settings.json"
    CLAUDE_PROJECT_DIR="$ws" python3 "$PLUGIN_DIR/scripts/tanka_status.py" "$ws"
  else
    echo "(sin workspace en $ws; ejecuta tanka init)"
  fi
}

cmd_test() {
  cd "$TANKA_REPO" && python3 -m unittest discover -s tests -v
}

case "${1:-}" in
  init) shift; cmd_init "$@";;
  start) shift; cmd_start "$@";;
  run) shift; cmd_run "$@";;
  doctor) shift; cmd_doctor "$@";;
  test) shift; cmd_test "$@";;
  -h|--help|help|"") usage;;
  *) echo "✗ Comando desconocido: $1" >&2; usage; exit 1;;
esac
