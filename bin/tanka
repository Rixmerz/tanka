#!/usr/bin/env bash
# Tanka launcher. The launcher itself is tanka.py, the same on Linux, macOS and Windows (from Git Bash too,
# or tanka.cmd from PowerShell and cmd); this only finds a Python 3 to run it with.
src="${BASH_SOURCE[0]}"
case "$src" in */*) here="${src%/*}";; *) here=.;; esac
for py in "${TANKA_PYTHON:-}" python3 python; do
  # Windows ships python3/python stubs that only open the Store: a Python must actually run.
  if [[ -n "$py" ]] && command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
    exec "$py" "$here/tanka.py" "$@"
  fi
done
echo "x Tanka needs Python 3.9 or newer (python3 or python on PATH, or TANKA_PYTHON)." >&2
exit 1
