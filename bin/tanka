#!/usr/bin/env bash
# Tanka launcher: starts Claude Code (Haiku by default) in a clean workspace with
# ONLY the Tanka plugin, ONLY Tanka's own MCP server (the tools under
# .claude/skills/*/tools/), and no user settings.
set -euo pipefail

TANKA_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_DIR="${TANKA_PLUGIN_DIR:-$TANKA_REPO/plugin}"
TEMPLATE_DIR="$TANKA_REPO/workspace-template"
DEFAULT_WS="${TANKA_HOME:-$HOME/tanka-workspace}"
# Named workspaces live here, as directories or as symlinks to a workspace kept elsewhere.
WORKSPACES_DIR="${TANKA_WORKSPACES:-$HOME/.tanka/workspaces}"
# Names that are commands cannot be workspace names.
RESERVED="init start resume run doctor test tools dev help whatsapp"
# Interactive sessions skip Claude Code prompts; the Tanka hooks and --disallowedTools still apply.
PERMISSION_MODE="${TANKA_PERMISSION_MODE:-bypassPermissions}"
MODEL="${TANKA_MODEL:-haiku}"
# Authoring designs tools a small model must use correctly: think it through.
DEV_EFFORT="${TANKA_DEV_EFFORT:-high}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

usage() {
  cat <<USAGE
tanka - a guardrailed assistant harness on top of Claude Haiku

Usage:
  tanka <name>                     Reopen the named workspace: pick a previous session (a new one if it has none)
  tanka start <name> [-- args...]  New session in the workspace; creates it first if it does not exist
  tanka init [name|dir]            Create a clean workspace without starting it
  tanka resume [name|dir]          Same as tanka <name> (never plain claude -r)
  tanka run "task" [dir] [--objective name] [--max-turns N] [--budget USD]
                                   Delegated task, no human in the loop (fail-closed: sends are denied)
  tanka doctor [dir]               Check configuration, plugin and state
  tanka tools check|list [dir]     Validate or list the workspace's tools
  tanka tools test <tool> '<json>' [dir]
                                   Run one tool exactly as the assistant would, without Claude
  tanka dev [name|dir]             Authoring session (your default model) to create skills and tools
  tanka test                       Run the harness test suite
  tanka whatsapp link|status       Link WhatsApp (QR in this terminal), or check the link
  tanka whatsapp install <name> [--scope S]
                                   Add the WhatsApp skill to a workspace

Every [dir] also takes a workspace name. A name is a directory (or a symlink to
one) under $WORKSPACES_DIR; without one, the default is $DEFAULT_WS.
USAGE
  list_workspaces
  cat <<USAGE

Environment: TANKA_HOME (default workspace), TANKA_WORKSPACES (named workspaces), TANKA_MODEL (haiku), TANKA_PLUGIN_DIR, TANKA_PERMISSION_MODE (bypassPermissions), TANKA_DEV_EFFORT (high), TANKA_AUTOCOMPACT_PCT (60), CLAUDE_BIN
USAGE
}

is_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; }

list_workspaces() {
  local found="" d
  for d in "$WORKSPACES_DIR"/*/; do
    [[ -f "$d.tanka/policy.json" ]] && found+=" $(basename "$d")"
  done
  echo "Workspaces:${found:- (none yet; create one with: tanka start <name>)}"
}

# A bare word is a workspace name under WORKSPACES_DIR; anything with a slash is a path.
# Names resolve through symlinks to the real directory, because Claude Code keys a
# project's session history by its real path and `resume` must find it.
resolve_ws() {
  local d="${1:-$DEFAULT_WS}"
  [[ "$d" == "--" ]] && d="$DEFAULT_WS"
  if is_name "$d"; then
    if [[ -d "$WORKSPACES_DIR/$d" ]]; then (cd -P "$WORKSPACES_DIR/$d" && pwd); else echo "$WORKSPACES_DIR/$d"; fi
    return
  fi
  echo "$d"
}

check_name() {
  if is_name "$1" && [[ " $RESERVED " == *" $1 "* ]]; then
    echo "x '$1' is a tanka command, not a workspace name. Pick another name." >&2; exit 1
  fi
}

# True when Claude Code has at least one saved session for this workspace.
has_sessions() {
  local key="${1//[^a-zA-Z0-9]/-}"
  compgen -G "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$key/*.jsonl" >/dev/null
}

require_ws() {
  local ws="$1"
  if [[ ! -f "$ws/.tanka/policy.json" ]]; then
    echo "x '$ws' is not a Tanka workspace (no .tanka/policy.json). Run: tanka init $ws" >&2
    exit 1
  fi
}

cmd_init() {
  check_name "${1:-}"
  local ws; ws="$(resolve_ws "${1:-}")"
  if [[ -e "$ws/.tanka/policy.json" ]]; then
    echo "x A workspace already exists at $ws (refusing to overwrite)." >&2; exit 1
  fi
  mkdir -p "$ws"
  cp -R "$TEMPLATE_DIR/." "$ws/"
  mkdir -p "$ws/.tanka/state" "$ws/.tanka/drafts" "$ws/.claude/skills"
  local ref="$ws"; is_name "${1:-}" && ref="$1"
  echo "+ Workspace created at $ws"
  echo "  1. Build its skills and tools: tanka dev $ref   (rules: docs/skill-rules.md, docs/tool-rules.md)"
  echo "  2. Check them: tanka tools check $ref"
  echo "  3. Open it: tanka $ref   The first session asks which language to work in."
}

common_args() {
  local ws="$1"
  # Isolation: no user settings, no foreign MCP servers, no other plugins, no
  # browser integration. Tool search stays off: with at most 15 tools there is
  # nothing to search, and a small model should see its tools up front.
  printf '%s\n' \
    --setting-sources project,local \
    --strict-mcp-config --mcp-config
  python3 "$PLUGIN_DIR/scripts/tanka_tools.py" mcp-config "$ws" "$PLUGIN_DIR"
  printf '%s\n' \
    --plugin-dir "$PLUGIN_DIR" \
    --model "$MODEL" \
    --no-chrome \
    --disallowedTools Bash PowerShell NotebookEdit WebSearch WebFetch
}
export ENABLE_TOOL_SEARCH=false
# The workspace's own settings refuse every prompt without this, so a plain
# `claude` or `claude -r` there (no Tanka tools, no hooks, the user's plugins)
# stops at the first message instead of running as an unguarded assistant.
export TANKA_LAUNCHED=1
# Haiku follows its rules less well as the context grows (docs/research/02), so
# compact earlier than the default. TANKA_AUTOCOMPACT_PCT=100 keeps the default.
export CLAUDE_CODE_AUTOCOMPACT_PCT_OVERRIDE="${TANKA_AUTOCOMPACT_PCT:-60}"

cmd_start() {
  local arg="${1:-}"
  [[ "$arg" == "--" ]] && arg=""
  check_name "$arg"
  local ws; ws="$(resolve_ws "$arg")"; [[ -n "$arg" ]] && shift
  [[ "${1:-}" == "--" ]] && shift || true
  if [[ ! -f "$ws/.tanka/policy.json" ]]; then
    # A typo here would silently create a new, empty assistant, so ask first.
    [[ -t 0 ]] || { echo "x No workspace at $ws. Create it with: tanka init ${arg:-$ws}" >&2; exit 1; }
    list_workspaces >&2
    read -r -p "No workspace '${arg:-$ws}' yet. Create it at $ws? [y/N] " ok
    [[ "$ok" == [yYsS]* ]] || { echo "x Not created." >&2; exit 1; }
    cmd_init "${arg:-$ws}"
  fi
  cd "$ws"
  mapfile -t ARGS < <(common_args "$ws")
  exec "$CLAUDE_BIN" "${ARGS[@]}" --permission-mode "$PERMISSION_MODE" "$@"
}

cmd_resume() {
  local arg="${1:-}"
  local ws; ws="$(resolve_ws "$arg")"
  if [[ ! -f "$ws/.tanka/policy.json" ]]; then
    echo "x No workspace '${arg:-$ws}'." >&2; list_workspaces >&2
    echo "  To create it: tanka start ${arg:-<name>}" >&2; exit 1
  fi
  if has_sessions "$ws"; then
    cmd_start "$ws" -- --resume
  else
    echo "+ No previous sessions in ${arg:-$ws}; starting a new one." >&2
    cmd_start "$ws"
  fi
}

cmd_run() {
  local task="${1:-}"; shift || true
  [[ -z "$task" ]] && { echo "x No task given." >&2; usage; exit 1; }
  local ws="$DEFAULT_WS" objective="" max_turns="${TANKA_MAX_TURNS:-20}" budget="${TANKA_BUDGET_USD:-1.00}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --objective) objective="$2"; shift 2;;
      --max-turns) max_turns="$2"; shift 2;;
      --budget) budget="$2"; shift 2;;
      --) shift; break;;
      *) ws="$(resolve_ws "$1")"; shift;;
    esac
  done
  require_ws "$ws"
  cd "$ws"
  if [[ -n "$objective" ]]; then
    local src="$ws/.tanka/objectives/$objective.json"
    [[ -f "$src" ]] || { echo "x No such file: $src" >&2; exit 1; }
    mkdir -p "$ws/.tanka/state"
    python3 - "$src" "$ws/.tanka/state/objective.json" <<'PY'
import json, sys, time
src, dst = sys.argv[1], sys.argv[2]
obj = json.load(open(src, encoding="utf-8"))
obj["status"] = "active"
obj["created_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
obj["may_send"] = False  # delegated mode: never send without a human
json.dump(obj, open(dst, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print(f"+ Objective '{obj.get('title')}' activated (may_send forced to false in delegated mode)")
PY
  fi
  mapfile -t ARGS < <(common_args "$ws")
  # Fail-closed: anything that would ask for confirmation is denied automatically.
  "$CLAUDE_BIN" "${ARGS[@]}" -p "$task" \
    --permission-mode default --permission-prompts none \
    --max-turns "$max_turns" --max-budget-usd "$budget" \
    --output-format text "$@"
}

cmd_doctor() {
  local ws; ws="$(resolve_ws "${1:-}")"
  echo "Repo:     $TANKA_REPO"
  echo "Plugin:   $PLUGIN_DIR"
  echo "Workspace: $ws"
  command -v "$CLAUDE_BIN" >/dev/null || { echo "x '$CLAUDE_BIN' not found in PATH"; exit 1; }
  echo "Claude:   $("$CLAUDE_BIN" --version 2>/dev/null | head -1)"
  command -v python3 >/dev/null || { echo "x python3 is required by the hooks"; exit 1; }
  echo "Python:   $(python3 --version)"
  echo "--- plugin validate"
  "$CLAUDE_BIN" plugin validate "$PLUGIN_DIR" || true
  if [[ -f "$ws/.tanka/policy.json" ]]; then
    echo "--- workspace"
    for f in policy.json persona.json mcp.json; do
      if python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$ws/.tanka/$f" 2>/dev/null; then echo "+ .tanka/$f"; else echo "x .tanka/$f is invalid"; fi
    done
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$ws/.claude/settings.json" && echo "+ .claude/settings.json"
    CLAUDE_PROJECT_DIR="$ws" python3 "$PLUGIN_DIR/scripts/tanka_status.py" "$ws"
  else
    echo "(no workspace at $ws; run tanka init)"
  fi
}

cmd_tools() {
  local sub="${1:-check}"; shift || true
  case "$sub" in
    check|list)
      local ws; ws="$(resolve_ws "${1:-}")"; require_ws "$ws"
      python3 "$PLUGIN_DIR/scripts/tanka_tools.py" "$sub" "$ws";;
    test)
      local tool="${1:-}" args="${2:-}" ws; ws="$(resolve_ws "${3:-}")"; require_ws "$ws"
      [[ -z "$tool" ]] && { echo "x Usage: tanka tools test <tool> '<json args>' [dir]" >&2; exit 1; }
      python3 "$PLUGIN_DIR/scripts/tanka_tools.py" test "$ws" "$tool" "${args:-{\}}";;
    *) echo "x Unknown: tanka tools $sub" >&2; usage; exit 1;;
  esac
}

cmd_dev() {
  local ws; ws="$(resolve_ws "${1:-}")"; shift || true
  [[ "${1:-}" == "--" ]] && shift || true
  require_ws "$ws"
  ws="$(cd "$ws" && pwd)"
  # Authoring runs from the repo on the user's normal model and settings, with
  # the workspace added as a directory. It never runs inside the workspace, so
  # the assistant's deny rules and CLAUDE.md do not apply to the author, and
  # the assistant itself can never write a tool.
  cd "$TANKA_REPO"
  export TANKA_WORKSPACE="$ws"
  exec "$CLAUDE_BIN" --plugin-dir "$TANKA_REPO/builder" --add-dir "$ws" --effort "$DEV_EFFORT" \
    --append-system-prompt "Tanka authoring mode. The Tanka workspace is $ws. Skills go in $ws/.claude/skills/<skill>/, tools in $ws/.claude/skills/<skill>/tools/. Follow docs/skill-rules.md, docs/tool-rules.md and, for a tool run by a stronger model, docs/subagent-rules.md in this repository, and verify every tool with bin/tanka tools check and bin/tanka tools test before calling it done." "$@"
}

cmd_test() {
  cd "$TANKA_REPO" && python3 -m unittest discover -s tests -v
}

case "${1:-}" in
  init) shift; cmd_init "$@";;
  start) shift; cmd_start "$@";;
  resume) shift; cmd_resume "$@";;
  run) shift; cmd_run "$@";;
  doctor) shift; cmd_doctor "$@";;
  test) shift; cmd_test "$@";;
  tools) shift; cmd_tools "$@";;
  dev) shift; cmd_dev "$@";;
  whatsapp) shift
    if [[ "${1:-}" == install ]]; then
      # Resolve the workspace here, so names work exactly as in every other command.
      ws="$(resolve_ws "${2:-}")"; require_ws "$ws"
      exec python3 "$TANKA_REPO/modules/whatsapp/cli.py" install "$ws" "$(basename "${2:-$ws}")" "${@:3}"
    fi
    exec python3 "$TANKA_REPO/modules/whatsapp/cli.py" "$@";;
  -h|--help|help|"") usage;;
  -*) echo "x Unknown option: $1" >&2; usage; exit 1;;
  *) cmd_resume "$@";;
esac
