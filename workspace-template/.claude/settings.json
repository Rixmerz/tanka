{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "haiku",
  "enabledPlugins": {},
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash",
      "PowerShell",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "allow": [
      "Read(./.tanka/**)",
      "Edit(./.tanka/state/**)",
      "Edit(./.tanka/drafts/**)",
      "Edit(./.tanka/persona.json)"
    ]
  },
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md"
  ],
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "12000"
  }
}
